<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "windows-app": the zipped app folder (dist/win-unpacked) uploaded
  by .github/workflows/windows.yml. Signs only Haven.exe, the program built from this repository.
  The Electron and native module DLLs in the folder are third-party binaries and are left as they
  are. SignPath keeps its own copy of this file; paste any change into the project's artifact
  configuration there as well.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Haven.exe" product-name="Haven">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
