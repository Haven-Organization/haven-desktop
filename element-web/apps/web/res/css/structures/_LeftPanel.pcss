.mx_MatrixChat--with-avatar {
    .mx_LeftPanel,
    .mx_LeftPanel .mx_LeftPanel_roomListContainer {
        background-color: transparent;
    }
}

.mx_LeftPanel_outerWrapper {
    display: flex;
    flex-direction: column;
    max-width: 50%;
    position: relative;
}

/* Haven: independent second clip layer around just the room-list-paired BackdropPanel (see
   LoggedInView.tsx), mirroring .social_Sidebar_backdropClip in social-overlay.scss and
   .mx_SpacePanel_backdropClip in _SpacePanel.pcss - see either rule's own doc for the full
   explanation of why .mx_BackdropPanel's own overflow: hidden isn't always enough on its own
   (combining `overflow: hidden` with the `filter` and `transform` it also carries, all on the same
   element, is a known cross-engine edge case that can let the blur escape its own clip box - which
   both bled visually onto the room list's own content, e.g. avatars/room names, that's meant to sit
   crisply on top of it unblurred, and read as part of why the new room list's version of this effect
   looked weaker than the old room list's). */
.mx_LeftPanel_backdropClip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
}

.mx_LeftPanel_wrapper,
.mx_LeftPanel {
    --collapsedWidth: 68px;
}

.mx_LeftPanel_panel {
    .mx_LeftPanel_outerWrapper {
        height: 100%;
        max-width: none;
    }

    .mx_LeftPanel_wrapper--user {
        width: 100%;
    }
}

.mx_LeftPanel_wrapper {
    display: flex;
    flex-direction: row;
    flex: 1;
    height: 100%; /* ensure space panel is still scrollable with an outer wrapper */

    .mx_LeftPanel_wrapper--user {
        display: flex;
        overflow: hidden;
        position: relative;
        /* For enhanced visibility under contrast control */
        outline: 1px solid transparent;

        &[data-collapsed] {
            max-width: var(--collapsedWidth);
        }
    }
}

.mx_LeftPanel {
    background-color: var(--cpd-color-bg-canvas-default);
    /* The room list is not designed to be collapsed to just icons. */
    /* 224 + 68(spaces bar) was deemed by design to be a good minimum for the left panel. */
    --collapsedWidth: 224px;

    /* Create a row-based flexbox for the space panel and the room list */
    display: flex;
    contain: content;
    position: relative;
    flex-grow: 1;
    overflow: hidden;

    .mx_LeftPanel_roomListContainer {
        flex: 1 0 0;
        min-width: 0;
        /* Create another flexbox (this time a column) for the room list components */
        display: flex;
        flex-direction: column;
    }

    /* These styles override the defaults for the minimized (66px) layout */
    &.mx_LeftPanel_minimized {
        flex-grow: 0;
        min-width: unset;
        width: unset !important;

        .mx_LeftPanel_roomListContainer {
            width: var(--collapsedWidth);
        }
    }
}

.mx_LeftPanel_newRoomList {
    /* Thew new rooms list is not designed to be collapsed to just icons. */
    /* 224 + 68(spaces bar) was deemed by design to be a good minimum for the left panel. */
    --collapsedWidth: 224px;
    /* Important to force the color on ED titlebar until we remove the old room list */
    background-color: var(--cpd-color-bg-canvas-default) !important;
}

/* Haven: without this, the plain rule above stays fully opaque and hides BackdropPanel's
   blurred-avatar background behind the new room list entirely. Higher specificity than the plain
   rule above wins this over it despite both being !important.

   Plain transparent, NOT a blend - this class sits on two elements on the way down to
   .mx_RoomListPanel (the new list's actual visible panel, in _RoomListPanel.pcss), which is the one
   that does the real "blend in the panel color at the configured opacity" compositing. If this also
   blended, the opacity setting would compound across multiple nested partial-opacity layers and read
   far more washed-out than the same setting on the old room list (see
   legacy-room-list/css/_LeftPanel.pcss's own doc on mx_LeftPanel_wrapper--user for the full
   reasoning) - going fully transparent here instead just passes that single blend through
   unmodified. */
.mx_MatrixChat--with-avatar .mx_LeftPanel_newRoomList {
    background-color: transparent !important;
}

#left-panel .mx_LeftPanel_wrapper--user {
    /*
     * Disable background when using the new room list.
     * This background sometimes shows when the panel is resized and it looks like a thicker border.
     */
    background: none;
}
