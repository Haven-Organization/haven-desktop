.mx_UserDevicesDialog {
    /* Haven: no max-height/overflow-y of its own here - the base .mx_Dialog wrapper (_common.pcss)
       already scrolls its whole content when it overflows. Giving this list its own scroll
       container on top of that produced two nested scrollbars for an account with many devices. */
    .mx_UserDevicesDialog_list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .mx_UserDevicesDialog_device {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-3x);
        padding: var(--cpd-space-3x) 0;

        &:not(:last-child) {
            border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);
        }
    }

    .mx_UserDevicesDialog_device_icon {
        flex-shrink: 0;
    }

    .mx_UserDevicesDialog_device_info {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .mx_UserDevicesDialog_device_name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mx_UserDevicesDialog_device_id {
        color: var(--cpd-color-text-secondary);
    }
}
