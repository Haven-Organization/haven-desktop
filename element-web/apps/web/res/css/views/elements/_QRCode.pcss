.mx_QRCode {
    img {
        border-radius: 8px;
    }

    .mx_QRCode_unavailable {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 200px;
        min-height: 200px;
        padding: 16px;
        box-sizing: border-box;
        text-align: center;
        border: 1px solid var(--cpd-color-border-interactive-secondary);
        border-radius: 8px;
        color: var(--cpd-color-text-secondary);
        font-size: 0.9rem;
    }
}
