/*
 * Haven: rich embeds for links - see src/components/views/messages/RichEmbed.tsx.
 */

.mx_RichEmbed {
    --RichEmbed-width: 560px;
    --RichEmbed-media-max-height: 480px;

    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    max-width: 100%;
}

/* Players and X posts take the full embed width; images and videos keep their own size. */
.mx_RichEmbed--youtube,
.mx_RichEmbed--twitch {
    width: var(--RichEmbed-width);
}

.mx_RichEmbed--x {
    width: 550px;
}

.mx_RichEmbed--placeholder {
    width: var(--RichEmbed-width);
}

/* Stands in for an embed that would load from the link's own site, until the user asks for it. */
.mx_RichEmbed_placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--cpd-space-3x);
    min-height: 120px;
    padding: var(--cpd-space-4x);
    box-sizing: border-box;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 12px;
    background: var(--cpd-color-bg-subtle-secondary);
    text-align: center;

    .mx_RichEmbed_actions {
        justify-content: center;
    }
}

.mx_RichEmbed_placeholder--video .mx_RichEmbed_placeholder {
    aspect-ratio: 16 / 9;
    max-height: 80vh;
}

.mx_RichEmbed_placeholderLabel {
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-secondary);
    overflow-wrap: anywhere;
}

.mx_RichEmbed_timeline.mx_RichEmbed--preview {
    width: var(--MediaPreview-width);
}

.mx_RichEmbed_group {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
}

/* The stock group's own spacing, which a lone tile doesn't need. */
.mx_RichEmbed_card {
    width: 100%;
    margin: 0;
}

/* The checkbox sits to the right of the button; its text wraps rather than dropping below. */
.mx_RichEmbed_actions {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--cpd-space-4x);

    > button {
        flex-shrink: 0;
        width: auto;
    }
}

.mx_RichEmbed_remember {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: var(--cpd-space-1-5x);
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
    cursor: pointer;
    user-select: none;

    input {
        margin: 0;
        accent-color: var(--cpd-color-bg-action-primary-rest);
        cursor: pointer;
    }
}

.mx_RichEmbed_player,
.mx_RichEmbed_cover {
    display: block;
    width: 100%;
    max-height: 80vh;
    border: 0;
    border-radius: 12px;
    background: #000;
}

/* A portrait player (YouTube Shorts) at full width would be far too tall. */
.mx_RichEmbed--portrait {
    width: auto;
}

.mx_RichEmbed--portrait .mx_RichEmbed_player,
.mx_RichEmbed--portrait .mx_RichEmbed_cover {
    width: auto;
    height: min(80vh, 640px);
    align-self: flex-start;
}

.mx_RichEmbed_cover {
    position: relative;
    overflow: hidden;
    padding: 0;
    cursor: pointer;
    color: #fff;

    img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    &:hover .mx_RichEmbed_playButton,
    &:focus-visible .mx_RichEmbed_playButton {
        background: var(--cpd-color-bg-action-primary-rest);
    }
}

.mx_RichEmbed_coverTitle {
    position: absolute;
    inset: 0 0 auto;
    padding: var(--cpd-space-3x) var(--cpd-space-4x) var(--cpd-space-8x);
    background: linear-gradient(rgb(0 0 0 / 70%), transparent);
    font: var(--cpd-font-body-md-semibold);
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_RichEmbed_playButton {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgb(0 0 0 / 65%);
    transition: background 0.15s;

    svg {
        margin-left: 4px;
    }
}

.mx_RichEmbed_xPost {
    display: block;
    width: 100%;
    /* Until X reports the post's height. */
    height: 360px;
    border: 0;
    border-radius: 12px;
    color-scheme: normal;
}

.mx_RichEmbed_imageButton {
    display: block;
    max-width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    align-self: flex-start;
}

.mx_RichEmbed_image,
.mx_RichEmbed_video {
    display: block;
    max-width: min(100%, var(--RichEmbed-width));
    max-height: var(--RichEmbed-media-max-height);
    height: auto;
    border-radius: 12px;
    object-fit: contain;
}

.mx_RichEmbed_image {
    /* Width and height from the preview, when there is one, are only for reserving space. */
    width: auto;
}

.mx_RichEmbed_video {
    background: #000;
}

.mx_RichEmbed_bar {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-4x);
    font: var(--cpd-font-body-sm-regular);

    a,
    button {
        display: inline-flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        padding: 0;
        border: 0;
        background: none;
        color: var(--cpd-color-text-secondary);
        font: inherit;
        text-decoration: none;
        cursor: pointer;

        &:hover {
            color: var(--cpd-color-text-primary);
            text-decoration: underline;
        }
    }
}

.mx_RichEmbed_failed {
    padding: var(--cpd-space-3x) var(--cpd-space-4x);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 12px;
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_RichEmbed_moreToggle {
    align-self: flex-start;
}

.mx_ResetEmbedPreferencesButton {
    align-self: flex-start;
}
