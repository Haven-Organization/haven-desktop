/*
 * Haven: webxdc games - see src/components/views/messages/WebxdcGame.tsx.
 */

.mx_WebxdcGame {
    --WebxdcGame-width: 560px;
    --WebxdcGame-height: 640px;

    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    width: min(100%, var(--WebxdcGame-width));
    box-sizing: border-box;
}

/* The game as a cartridge, as the Nostr bridge shows games. */
.mx_WebxdcGame_cartridge {
    display: block;
    width: 168px;
    padding: 0;
    border: 0;
    background: none;
    line-height: 0;

    &:is(button) {
        cursor: pointer;
        transition: transform 0.15s;

        &:hover:not(:disabled),
        &:focus-visible {
            transform: translateY(-2px);
        }

        &:disabled {
            cursor: progress;
        }
    }
}

.mx_WebxdcCartridge {
    display: block;
    width: 100%;
    height: auto;
}

.mx_WebxdcCartridge_title {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font: 700 44px / 1.15 var(--cpd-font-family-sans);
    color: #3c424c;
    text-align: center;
    overflow-wrap: anywhere;
    overflow: hidden;
}

.mx_WebxdcGame_footer {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
}

.mx_WebxdcGame_details {
    flex: 1;
    min-width: 0;
}

.mx_WebxdcGame_name {
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_WebxdcGame_kind {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_WebxdcGame_buttons {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
}

.mx_WebxdcGame_note {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_WebxdcGame_frame {
    box-sizing: border-box;
    width: 100%;
    height: min(var(--WebxdcGame-height), 80vh);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    background: #fff;

    iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
    }

    &:fullscreen {
        height: 100%;
        border: 0;
        border-radius: 0;
    }
}

.mx_WebxdcGame_stopped {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: var(--cpd-space-4x);
    box-sizing: border-box;
    background: var(--cpd-color-bg-subtle-secondary);
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-secondary);
    text-align: center;

    p {
        margin: 0;
        max-width: 420px;
    }
}

.mx_WebxdcGame_bar {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-4x);
    padding-inline-end: var(--cpd-space-3x);
    font: var(--cpd-font-body-sm-regular);

    button {
        display: inline-flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        padding: 0;
        border: 0;
        background: none;
        color: var(--cpd-color-text-secondary);
        font: inherit;
        cursor: pointer;

        &:hover:not(:disabled) {
            color: var(--cpd-color-text-primary);
            text-decoration: underline;
        }

        &:disabled {
            color: var(--cpd-color-text-disabled);
            cursor: default;
        }
    }
}

.mx_WebxdcGame_barName {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--cpd-color-text-secondary);
}

.mx_WebxdcGame_warning {
    color: var(--cpd-color-text-critical-primary);
}
