/*
 * Haven: MSC2545 (Image Packs) room settings tab.
 */

.mx_EmojiStickersSettingsTab_newPack {
    display: flex;
    align-items: flex-end;
    gap: var(--cpd-space-3x);
}

.mx_EmojiStickersSettingsTab_empty {
    color: var(--cpd-color-text-secondary);
}

.mx_EmojiStickersSettingsTab_packList {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    /* Haven: same shrink-wrap-by-default grid quirk as packHeader/imageList below - this list is
       itself the grid item, so without an explicit stretch it only sizes to fit its content and
       can overflow the grid track outright once a descendant has long unwrappable text, instead
       of clamping to the track width so rows can truncate and line up. */
    justify-self: stretch;
    min-width: 0;
}

.mx_EmojiStickersSettingsTab_packRow {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-2x);
    border-radius: 8px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    min-width: 0;
}

.mx_EmojiStickersSettingsTab_packInfo {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
}

.mx_EmojiStickersSettingsTab_packName,
.mx_EmojiStickersSettingsTab_packCount {
    /* Haven: truncate rather than wrap - a pack row's height must stay the same regardless of how
       long its name is, both so rows all line up and so the View/✕ buttons stay vertically
       centered at the same position on every row. */
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    min-width: 0;
}

.mx_EmojiStickersSettingsTab_packName {
    font-weight: var(--cpd-font-weight-semibold);
}

.mx_EmojiStickersSettingsTab_packCount {
    color: var(--cpd-color-text-secondary);
    font-size: 0.85rem;
}

.mx_EmojiStickersSettingsTab_avatar {
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
}

.mx_EmojiStickersSettingsTab_avatar_placeholder {
    background-color: var(--cpd-color-bg-subtle-secondary);
}

.mx_EmojiStickersSettingsTab_removeBtn {
    min-width: 32px;
}

.mx_EmojiStickersSettingsTab_backBar {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    margin-bottom: var(--cpd-space-3x);
}

/* Haven: red reminder next to Back once the pack has unsaved changes - see requirement 5. Back
   itself isn't guarded (only the dialog's own X/click-outside/other-category navigation is, via
   SettingsNavigationGuardContext), so this is the only warning a user gets before Back would lose
   local edits. */
.mx_EmojiStickersSettingsTab_unsavedWarning {
    color: var(--cpd-color-text-critical-primary);
    font: var(--cpd-font-body-sm-semibold);
}

.mx_EmojiStickersSettingsTab_packHeader {
    display: flex;
    align-items: center;
    /* Haven: the settings subsection lays rows out on a CSS grid with `justify-items: flex-start`,
       so this row shrink-wraps to its own content width by default - stretch it so the editable
       name field below fills the remaining width rather than shrink-wrapping to nothing. */
    justify-self: stretch;
    gap: var(--cpd-space-4x);
    padding-inline: var(--cpd-space-2x);
    margin-bottom: var(--cpd-space-4x);
}

.mx_EmojiStickersSettingsTab_packHeaderInfo {
    flex: 1;
    min-width: 0;
}

/* Haven: the pack name field's own checkmark/X pair - shown whenever the typed name differs from
   the pack's own saved name (see PackEditor.tsx's own `nameEdited`), not via Compound's
   EditInPlace, whose focus-driven show/hide flickered on Cancel and hid on blur instead of
   staying up once edited. */
.mx_EmojiStickersSettingsTab_packNameEdit {
    display: flex;
    align-items: flex-end;
    gap: var(--cpd-space-2x);

    > .mx_Field {
        flex: 1;
        min-width: 0;
    }
}

.mx_EmojiStickersSettingsTab_packNameEditButtons {
    display: flex;
    gap: var(--cpd-space-1x);
    /* Haven: Field's own label sits above the input, so without this the icon buttons - which
       have no label row of their own - would sit centered against the label+input pair rather
       than lined up with just the input's own height. */
    padding-bottom: 2px;
}

.mx_EmojiStickersSettingsTab_uploadBtn {
    display: inline-flex;
    cursor: pointer;
}

/* Haven: the pack avatar + its always-visible edit pencil (see requirement 2) - same layered
   pattern as AvatarSetting.tsx's own .mx_AvatarSetting_avatar/_uploadButton, just built around
   PackAvatar's own size-prop-driven sizing instead of a fixed 120px circle. */
.mx_EmojiStickersSettingsTab_avatarEdit {
    position: relative;
    flex-shrink: 0;
    display: inline-block;
}

.mx_EmojiStickersSettingsTab_avatarEditTrigger {
    display: block;
    cursor: pointer;
}

.mx_EmojiStickersSettingsTab_avatarEditButton {
    position: absolute;
    bottom: -4px;
    right: -4px;
    width: 28px;
    height: 28px;
    border-radius: 32px;
    border: 1px solid var(--cpd-color-bg-canvas-default);
    background-color: var(--cpd-color-bg-canvas-default);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}

.mx_EmojiStickersSettingsTab_avatarEditButton:hover,
.mx_EmojiStickersSettingsTab_avatarEditButton_active {
    background-color: var(--cpd-color-bg-subtle-primary);
}

.mx_EmojiStickersSettingsTab_usageRow {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    max-width: 360px;

    select {
        /* Haven: leave room for the Field's chevron icon so it doesn't overlap long option text
           like "Emoji and stickers". */
        padding-right: 28px;
    }
}

.mx_EmojiStickersSettingsTab_imageSearch {
    margin-bottom: var(--cpd-space-3x);
}

.mx_EmojiStickersSettingsTab_imageList {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    margin-bottom: var(--cpd-space-3x);
    /* Haven: stretch to the full grid column width (see packHeader above) so each row's Edit
       button lands at the same right edge as the pack header's Edit/Done button. */
    justify-self: stretch;
    /* Haven: a pack with more images than fit on screen scrolls within this list rather than
       growing the whole settings page indefinitely. */
    max-height: 320px;
}

.mx_EmojiStickersSettingsTab_imageRow {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-1x) var(--cpd-space-2x);
    /* Haven: same border treatment as .mx_EmojiStickersSettingsTab_packRow on the list page this
       pack was opened from. */
    border-radius: 8px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
}

.mx_EmojiStickersSettingsTab_imageRow_editing {
    align-items: flex-start;
    background-color: var(--cpd-color-bg-subtle-secondary);
    border-radius: 8px;
    padding: var(--cpd-space-3x);
}

.mx_EmojiStickersSettingsTab_imageThumb {
    /* Haven: bumped from 32px - see requirement 4 */
    width: 40px;
    height: 40px;
    object-fit: contain;
    flex-shrink: 0;
}

.mx_EmojiStickersSettingsTab_imageShortcode {
    flex: 1;
    min-width: 0;
    font-family: var(--cpd-font-family-mono, monospace);
    /* Haven: truncate rather than wrap - see .mx_EmojiStickersSettingsTab_packName's own doc, same
       reasoning applied to image rows so every one stays the same height. */
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.mx_EmojiStickersSettingsTab_imageEditFields {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
}

.mx_EmojiStickersSettingsTab_saveBar {
    margin-top: var(--cpd-space-4x);
    display: flex;
    justify-content: flex-end;
    gap: var(--cpd-space-3x);
}

.mx_EmojiStickersSettingsTab_addImageRow {
    display: flex;
    align-items: flex-end;
    gap: var(--cpd-space-3x);
}

.mx_EmojiStickersSettingsTab_addImageOr {
    color: var(--cpd-color-text-secondary);
}

.mx_EmojiStickersSettingsTab_error {
    color: var(--cpd-color-text-critical-primary);
    margin-top: var(--cpd-space-2x);
}
