.mx_Field.mx_AppearanceUserSettingsTab_checkboxControlledField {
    width: 256px;
    /* Line up with Settings field toggle button */
    margin-inline-start: 0;
}

/* Haven: Settings > Appearance > Room List's backdrop-opacity slider - see BackdropPanel.tsx and
   RoomListBackdropWatcher.ts's own doc. */
.mx_AppearanceUserSettingsTab_roomListBackdropOpacity {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);

    label {
        flex: 1;
        font: var(--cpd-font-body-md-regular);
        color: var(--cpd-color-text-primary);
    }

    input[type="range"] {
        width: 200px;
        accent-color: var(--cpd-color-icon-accent-primary);
    }

    .mx_AppearanceUserSettingsTab_roomListBackdropOpacity_value {
        min-width: 3em;
        text-align: end;
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
    }
}
