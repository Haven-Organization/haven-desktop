/* the 'src' links are relative to the bundle.css, which is in a subdirectory.
 */

/* Twemoji COLR */
@font-face {
    font-family: Twemoji;
    font-weight: 400;
    src: url("/res/fonts/Twemoji_Mozilla/TwemojiMozilla-colr.woff2") format("woff2");
}
/* For at least Chrome on Windows 10, we have to explictly add extra weights for the emoji to appear in bold messages, etc. */
@font-face {
    font-family: Twemoji;
    font-weight: 600;
    src: url("/res/fonts/Twemoji_Mozilla/TwemojiMozilla-colr.woff2") format("woff2");
}

@font-face {
    font-family: Twemoji;
    font-weight: 700;
    src: url("/res/fonts/Twemoji_Mozilla/TwemojiMozilla-colr.woff2") format("woff2");
}

/*
 * Haven: alternative designs for the 🔫 emoji (U+1F52B). The bundled Twemoji font above draws the
 * water pistol Twemoji switched to in 2.6 (April 2018); these one-glyph fonts draw the modern
 * handgun from Twemoji's repository and the pre-2018 revolver instead. Each family covers only
 * that one codepoint, so a family placed ahead of "Twemoji" in the emoji font stack replaces just
 * that glyph and leaves everything else to Twemoji - FontWatcher builds that stack from the
 * "Haven.gunEmojiStyle" setting (the water pistol option adds neither, it's simply Twemoji's own).
 * Only takes effect while the bundled emoji font is on, since that's what puts these in the stack
 * at all. Same three weights as above for the same Chrome-on-Windows reason. Graphics are Twemoji's
 * own (CC-BY 4.0) - see res/fonts/Haven/README.txt.
 */
@font-face {
    font-family: "Haven Handgun";
    font-weight: 400;
    unicode-range: U+1F52B;
    src: url("/res/fonts/Haven/HavenHandgun-colr.woff2") format("woff2");
}

@font-face {
    font-family: "Haven Handgun";
    font-weight: 600;
    unicode-range: U+1F52B;
    src: url("/res/fonts/Haven/HavenHandgun-colr.woff2") format("woff2");
}

@font-face {
    font-family: "Haven Handgun";
    font-weight: 700;
    unicode-range: U+1F52B;
    src: url("/res/fonts/Haven/HavenHandgun-colr.woff2") format("woff2");
}

@font-face {
    font-family: "Haven Revolver";
    font-weight: 400;
    unicode-range: U+1F52B;
    src: url("/res/fonts/Haven/HavenRevolver-colr.woff2") format("woff2");
}

@font-face {
    font-family: "Haven Revolver";
    font-weight: 600;
    unicode-range: U+1F52B;
    src: url("/res/fonts/Haven/HavenRevolver-colr.woff2") format("woff2");
}

@font-face {
    font-family: "Haven Revolver";
    font-weight: 700;
    unicode-range: U+1F52B;
    src: url("/res/fonts/Haven/HavenRevolver-colr.woff2") format("woff2");
}
