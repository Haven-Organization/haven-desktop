/* the 'src' links are relative to the bundle.css, which is in a subdirectory.
 */

/* Twemoji COLR */
@font-face {
    font-family: "Twemoji";
    font-weight: 400;
    src: url("/res/fonts/Twemoji_Mozilla/TwemojiMozilla-colr.woff2") format("woff2");
}
/* For at least Chrome on Windows 10, we have to explictly add extra weights for the emoji to appear in bold messages, etc. */
@font-face {
    font-family: "Twemoji";
    font-weight: 600;
    src: url("/res/fonts/Twemoji_Mozilla/TwemojiMozilla-colr.woff2") format("woff2");
}
@font-face {
    font-family: "Twemoji";
    font-weight: 700;
    src: url("/res/fonts/Twemoji_Mozilla/TwemojiMozilla-colr.woff2") format("woff2");
}

/*
 * Haven: 🔫 (U+1F52B) drawn as a real pistol instead of the water pistol the Twemoji Mozilla font
 * above still carries (Twemoji swapped the art in 2.6, April 2018). Same "Twemoji" family, but a
 * later @font-face with a narrower unicode-range takes priority over earlier faces for the
 * codepoints they both cover - so this only ever replaces that one glyph, everything else still
 * comes from the faces above. Only applies while the bundled emoji font is on (it's what puts
 * "Twemoji" in the font stack in the first place). Same three weights as above for the same
 * Chrome-on-Windows reason. Font built from Twemoji's own assets/svg/1f52b.svg at commit a6f943b95
 * (CC-BY 4.0) - see res/fonts/Haven/README.txt.
 */
@font-face {
    font-family: "Twemoji";
    font-weight: 400;
    unicode-range: U+1F52B;
    src: url("/res/fonts/Haven/HavenPistol-colr.woff2") format("woff2");
}
@font-face {
    font-family: "Twemoji";
    font-weight: 600;
    unicode-range: U+1F52B;
    src: url("/res/fonts/Haven/HavenPistol-colr.woff2") format("woff2");
}
@font-face {
    font-family: "Twemoji";
    font-weight: 700;
    unicode-range: U+1F52B;
    src: url("/res/fonts/Haven/HavenPistol-colr.woff2") format("woff2");
}
