                    class="mx_AccessibleButton haven_KeyboardShortcut_editable"
                    role="button"
                    tabindex="0"
                  >
                    <div
                      class="mx_KeyboardShortcut"
                    >
                      <kbd>
                         
                        Ctrl
                         
                      </kbd>
                      +
                      <kbd>
                         
                        Shift
                         
                      </kbd>
                      +
                      <kbd>
                         
                        F6
                         
                      </kbd>
                    </div>
                  </div>
                </li>
              </ul>
            </div>
          </div>
          <div
            class="mx_SettingsSubsection"
          >
            <div
              class="mx_SettingsSubsectionHeading"
            >
              <h2
                class="mx_Heading_h4 mx_SettingsSubsectionHeading_heading"
              >
                Autocomplete
              </h2>
            </div>
            <div
              class="mx_SettingsSubsection_content"
            >
              <ul
                class="mx_KeyboardShortcut_shortcutList"
              >
                <li
                  class="mx_KeyboardShortcut_shortcutRow"
                >
                  Cancel autocomplete
                  <div
                    class="mx_KeyboardShortcut"
                  >
                    <kbd>
                       
                      Esc
                       
                    </kbd>
                  </div>
                </li>
                <li
                  class="mx_KeyboardShortcut_shortcutRow"
                >
                  Next autocomplete suggestion
                  <div
                    class="mx_KeyboardShortcut"
                  >
                    <kbd>
                       
                      ↓
                       
                    </kbd>
                  </div>
                </li>
                <li
                  class="mx_KeyboardShortcut_shortcutRow"
                >
                  Previous autocomplete suggestion
                  <div
                    class="mx_KeyboardShortcut"
                  >
                    <kbd>
                       
                      ↑
                       
                    </kbd>
                  </div>
                </li>
                <li
                  class="mx_KeyboardShortcut_shortcutRow"
                >
                  Complete
                  <div
                    class="mx_KeyboardShortcut"
                  >
                    <kbd>
                       
                      Enter
                       
                    </kbd>
                  </div>
                </li>
                <li
                  class="mx_KeyboardShortcut_shortcutRow"
                >
                  Force complete
                  <div
                    class="mx_KeyboardShortcut"
                  >
                    <kbd>
                       
                      Tab
                       
                    </kbd>
                  </div>
                </li>
              </ul>
            </div>
          </div>
          <div
            class="mx_AccessibleButton mx_AccessibleButton_hasKind mx_AccessibleButton_kind_danger"
            role="button"
            tabindex="0"
          >
            Reset to Default
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;
