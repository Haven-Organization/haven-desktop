-  // Label tooltips are kept in the DOM even when not visually open
-  if (!open && purpose !== "label") return null;
+  // Label tooltips need a stable, always-present element for aria-labelledby to keep resolving
+  // even while closed - but that doesn't require the full floating-positioned apparatus. Render a
+  // plain, non-floating copy while closed instead of the real FloatingPortal/refs.setFloating-
+  // connected node: floating-ui's `whileElementsMounted: autoUpdate` (see useTooltip.ts) only
+  // starts once BOTH the reference and floating elements are mounted, so never attaching
+  // `refs.setFloating` here means autoUpdate's own scroll/resize-driven position recalculation
+  // never runs for a tooltip nobody is looking at. Previously this rendered the real floating node
+  // (just visually clipped) unconditionally for every label tooltip for as long as it stayed
+  // mounted, each one independently recomputing its position on every scroll - cheap for one
+  // tooltip, expensive once dozens are mounted at once (e.g. a feed of many posts, each with
+  // several icon-only action buttons).
+  if (!open && purpose === "label") {
+    // position: absolute takes this out of normal document flow, same as the real FloatingPortal
+    // node effectively was (portaled to document.body, so never a layout sibling of its own
+    // trigger). Without this, this placeholder - clipped to zero *visible* area but not zero
+    // *layout* area - was still a real flex sibling wherever the tooltip's trigger sits, inflating
+    // any flex row it's in by its own text content's width (found 2026-08-11: room list hover
+    // menu buttons, each wrapped in a label tooltip via IconButton's `tooltip` prop, were
+    // overflowing their row and squeezing the room name down to zero width).
+    return (
+      <span className={classNames(styles.tooltip, styles.invisible)} style={{ position: "absolute" }}>
+        {children}
+      </span>
+    );
+  }
+
